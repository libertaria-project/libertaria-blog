      </svg>
    </a>
  </div>
</footer>

<style>
footer {
  background: #0a0a347f;
  border-top: 1px solid var(--color-red-dark, #8b0000);
  padding: 3rem 1rem 2rem;
  text-align: center;
  color: var(--color-gray);
  margin-top: 4rem;
}
.footer-routing {
  display: flex;
  justify-content: center;
  gap: 4rem;
  flex-wrap: wrap;
  margin-bottom: 2.5rem;
  max-width: 900px;
  margin-left: auto;
  margin-right: auto;
}
.footer-col {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  text-align: left;
}
.footer-col-label {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-gold);
  margin-bottom: 0.3rem;
}
.footer-col a {
  font-size: 0.85rem;
  color: var(--color-gray);
  text-decoration: none;
  transition: color 0.2s;
}
.footer-col a:hover { color: var(--color-gold); }
.footer-copy {
  font-size: 0.8rem;
  opacity: 0.5;
  margin-bottom: 1.5rem;
}
.social-links { display: flex; justify-content: center; gap: 1rem; }
.social-links a { color: var(--color-gray); transition: color 0.2s; }
.social-links a:hover { color: var(--color-gold); }
</style>
