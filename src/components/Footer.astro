---
const today = new Date();
---

<footer>
  <div class="footer-routing">
    <div class="footer-col">
      <span class="footer-col-label">The Foundation</span>
      <a href="https://sovereign-society.org" target="_blank">sovereign-society.org</a>
      <a href="https://sovereign-society.org#exitarianism">Exitarianism</a>
      <a href="https://sovereign-society.org#school">The School</a>
      <a href="https://sovereign-society.org/canon/">The Canon</a>
      <a href="https://sovereign-society.org#chapter-zero">Chapter Zero</a>
      <a href="https://sovereign-society.org#membership">Membership</a>
    </div>
    <div class="footer-col">
      <span class="footer-col-label">This Publication</span>
      <a href="/dispatches/">Dispatches</a>
      <a href="/manifestos/">Manifestos</a>
      <a href="/geopolitics/">Geopolitics</a>
      <a href="/civilization-faith/">Civilization & Faith</a>
      <a href="/doctrine/">Doctrine</a>
      <a href="/stories/">Stories</a>
      <a href="/open-problems/">Open Problems</a>
    </div>
    <div class="footer-col">
      <span class="footer-col-label">For Builders</span>
      <a href="https://libertaria.dev" target="_blank">libertaria.dev</a>
      <a href="https://libertaria.dev#stack">The Stack</a>
      <a href="https://libertaria.dev/docs">Docs</a>
      <a href="https://git.libertaria.dev/libertaria/libertaria-stack" target="_blank">Source</a>
    </div>
  </div>
  <p class="footer-copy">&copy; {today.getFullYear()} Libertaria. Chapter Zero. Frankfurt & Budapest.</p>
  <div class="social-links">
    <a href="https://git.libertaria.dev/libertaria/libertaria-stack" target="_blank" aria-label="Source">
      <svg viewBox="0 0 16 16" aria-hidden="true" width="28" height="28">
