---
import HeaderLink from './HeaderLink.astro';
---

<header class="navbar">
	<div class="progress-bar"></div>
	<nav>
		<h2><a href="/">Libertaria</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/stories">Stories</HeaderLink>
			<HeaderLink href="https://git.libertaria.dev/libertaria/libertaria-stack" target="_blank">Git</HeaderLink>
		</div>
	</nav>
</header>

<script>
	// Scroll-linked Navbar Enhancement
	(function() {
		const navbar = document.querySelector('.navbar');
		const progressBar = document.querySelector('.progress-bar') as HTMLElement;
		if (!navbar) return;

		let ticking = false;

		function updateNavbar() {
			const scrollY = window.scrollY;
			const docHeight = document.documentElement.scrollHeight - window.innerHeight;
			
			// Transparent at top, solid when scrolled
			if (scrollY > 50) {
				navbar.classList.add('scrolled');
			} else {
				navbar.classList.remove('scrolled');
			}

			// Update progress bar
			if (progressBar && docHeight > 0) {
				const progress = Math.min((scrollY / docHeight) * 100, 100);
				progressBar.style.width = progress + '%';
			}

			ticking = false;
		}

		window.addEventListener('scroll', () => {
			if (!ticking) {
				requestAnimationFrame(updateNavbar);
				ticking = true;
			}
		});

		// Initial check
		updateNavbar();
	})();
</script>

<style>
	.navbar {
		position: sticky;
		top: 0;
		z-index: 100;
		transition: background var(--duration-base) var(--ease-out-expo),
		            backdrop-filter var(--duration-base) var(--ease-out-expo),
		            -webkit-backdrop-filter var(--duration-base) var(--ease-out-expo),
		            border-bottom-color var(--duration-base) var(--ease-out-expo);
		border-bottom: 1px solid transparent;
	}

	/* Transparent when at top */
	.navbar:not(.scrolled) {
		background: transparent;
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
	}

	/* Solid when scrolled */
	.navbar.scrolled {
		background: #0a0a347f;
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-bottom: 1px solid #ffd7004d;
	}

	/* Progress bar at bottom of header */
	.progress-bar {
		position: absolute;
		bottom: 0;
		left: 0;
		height: 2px;
		background: linear-gradient(90deg, var(--color-gold), var(--color-red));
		width: 0%;
		transition: width 50ms linear;
		z-index: 101;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
		padding: 1rem;
	}

	h2 {
		margin: 0;
		font-size: 1.5rem;
	}

	h2 a {
		color: var(--accent);
		text-decoration: none;
		font-weight: 700;
		transition: color var(--duration-fast) var(--ease-out-expo);
	}

	h2 a:hover {
		color: var(--color-gold-light);
	}

	.internal-links {
		display: flex;
		gap: 1.5rem;
	}

	@media (max-width: 600px) {
		.internal-links {
			gap: 1rem;
			font-size: 0.9rem;
		}
	}
</style>
