---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { CANONICAL_TAGS, CANONICAL_TAG_IDS } from '../../consts';

export async function getStaticPaths() {
  return CANONICAL_TAGS.map(tag => ({
    params: { tag: tag.id },
    props: { tagInfo: tag },
  }));
}

const { tag } = Astro.params;
const { tagInfo } = Astro.props;

const blogPosts = await getCollection('blog');
const stories = await getCollection('stories');
const now = new Date();
const tagPosts = [
  ...blogPosts.map(p => ({ ...p, href: `/blog/${p.slug}/`, kind: 'essay' })),
  ...stories.map(p => ({ ...p, href: `/stories/${p.slug}/`, kind: 'story' })),
]
  .filter(p => p.data.pubDate <= now && (p.data.tags || []).includes(tag as string))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Layout title={`#${tag} — Libertaria Dispatch`} description={tagInfo.desc}>
  <section class="tag-page">
    <header class="tag-header">
      <a href="/tags/" class="back-link">← All Tags</a>
      <div class="tag-title-row">
        <h1><span class="hash">#</span>{tag}</h1>
        <span class="post-count">{tagPosts.length} article{tagPosts.length !== 1 ? 's' : ''}</span>
      </div>
      <p class="tag-desc">{tagInfo.desc}</p>
    </header>

    {tagPosts.length === 0 ? (
      <div class="empty-state">
        <p>No articles tagged <strong>#{tag}</strong> yet.</p>
        <p class="hint">Check back soon — the frontier is moving fast.</p>
      </div>
    ) : (
      <div class="posts-grid">
        {tagPosts.map((post) => (
          <article class="post-card">
            <a href={post.href}>
              <div class="post-meta">
                <time>
                  {post.data.pubDate.toLocaleDateString('en-us', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                {post.data.editorial_lane && (
                  <span class="lane-badge">{post.data.editorial_lane.replace('-', ' ')}</span>
                )}
              </div>
              <h2>{post.data.title}</h2>
              <p class="post-desc">{post.data.description}</p>
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="post-tags">
                  {post.data.tags.slice(0, 4).map(t => (
                    <span class={`tag-chip ${CANONICAL_TAG_IDS.has(t) ? 'canonical' : 'other'}`}>
                      #{t}
                    </span>
                  ))}
                </div>
              )}
            </a>
          </article>
        ))}
      </div>
    )}
  </section>
</Layout>

<style>
  .tag-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-gold);
    text-decoration: none;
    margin-bottom: 1.5rem;
    opacity: 0.7;
    transition: opacity 0.2s;
  }
  .back-link:hover { opacity: 1; }

  .tag-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255, 215, 0, 0.15);
  }

  .tag-title-row {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .tag-title-row h1 {
    font-size: 2.5rem;
    color: var(--color-white);
    margin: 0;
  }

  .tag-title-row .hash {
    color: var(--color-gold);
  }

  .post-count {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-gray);
    opacity: 0.7;
  }

  .tag-desc {
    font-size: 1.05rem;
    color: var(--color-white-dim);
    line-height: 1.65;
    max-width: 600px;
    margin: 0;
  }

  .posts-grid {
    display: grid;
    gap: 1.25rem;
  }

  .post-card {
    background: var(--color-black-lighter);
    border: 1px solid rgba(255, 215, 0, 0.1);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
  }

  .post-card:hover {
    border-color: rgba(255, 215, 0, 0.35);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3), 0 0 20px rgba(255, 215, 0, 0.05);
    transform: translateX(4px);
  }

  .post-card a {
    display: block;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8rem;
    color: var(--color-gray);
    margin-bottom: 0.6rem;
  }

  .lane-badge {
    background: rgba(255, 215, 0, 0.1);
    color: var(--color-gold);
    padding: 0.1rem 0.5rem;
    border-radius: 4px;
    font-size: 0.7rem;
    text-transform: capitalize;
    font-family: var(--font-mono);
    letter-spacing: 0.05em;
  }

  .post-card h2 {
    font-size: 1.2rem;
    color: var(--color-white);
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
    transition: color 0.2s;
  }

  .post-card:hover h2 {
    color: var(--color-gold);
  }

  .post-desc {
    font-size: 0.9rem;
    color: var(--color-gray);
    line-height: 1.55;
    margin: 0 0 0.75rem 0;
  }

  .post-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .tag-chip {
    font-size: 0.72rem;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-family: var(--font-mono);
  }

  .tag-chip.canonical {
    background: rgba(255, 215, 0, 0.08);
    color: rgba(255, 215, 0, 0.7);
    border: 1px solid rgba(255, 215, 0, 0.15);
  }

  .tag-chip.other {
    background: rgba(255, 255, 255, 0.04);
    color: var(--color-gray);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .empty-state {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--color-gray);
  }

  .empty-state p { margin-bottom: 0.5rem; }

  .hint {
    font-size: 0.85rem;
    opacity: 0.6;
  }
</style>
