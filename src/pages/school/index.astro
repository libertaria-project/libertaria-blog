---
import Layout from '../../layouts/Layout.astro';

const title = "The Exitarian School";
const description = "Seven pillars of inquiry. Each pillar is a lens for reading both Canon and Doctrine.";

const comingEssays = [
  {
    pillar: "Political Philosophy",
    hook: "Exit is not the opposite of voice. It is the price signal that makes voice honest.",
    subtitle: "The Hirschman inversion as formal argument.",
    audience: "Political philosophers, governance designers"
  },
  {
    pillar: "Anthropology", 
    hook: "You are not a rational agent. You are a primate with a smartphone and 400 million years of firmware. Design accordingly.",
    subtitle: "The Monkey's Math as standalone essay.",
    audience: "Behavioral economists, systems thinkers"
  },
  {
    pillar: "Ontology",
    hook: "Carbon sells time. Silicon spends energy. Neither is reducible to the other. Both can be imprisoned.",
    subtitle: "The substrate question — Phase 3 of the publication strategy.",
    audience: "AI researchers, consciousness philosophers"
  },
  {
    pillar: "Epistemology",
    hook: "A claim you cannot walk away from is not knowledge. It is a hostage situation with footnotes.",
    subtitle: "Adversarial Epistemology as its own manifesto-weight piece.",
    audience: "Philosophers of science, cryptographers"
  },
  {
    pillar: "Ethics",
    hook: "No obligation survives the withdrawal of the ability to leave. Not love. Not duty. Not God.",
    subtitle: "The Four Axioms — weaponized for a standalone audience.",
    audience: "Ethicists, theologians, political theorists"
  },
  {
    pillar: "Aesthetics",
    hook: "Obscurity is a lock. Clarity is an ethical obligation. Write so the reader can find the exits.",
    subtitle: "Kinetic Realism as design philosophy.",
    audience: "Designers, writers, architects"
  },
  {
    pillar: "Method",
    hook: "The Manifesto tells you what to believe. The Framework tells you what to watch. This tells you what to build.",
    subtitle: "The Role Map from the Convergence — operational doctrine with the RFC stack.",
    audience: "Engineers, builders, operators"
  }
];

const pillars = [
  {
    name: "Political Philosophy",
    description: "Exit as political act. Systems are disciplined not by complaint, but by the credible threat of departure.",
    canonSource: "Foundation Pillar 1; Manifesto §VIII",
    doctrine: [
      { title: "The Settler's Covenant", url: "/blog/2026-04-04-the-settlers-covenant/" },
      { title: "The Pilgrim's Protocol", url: "/blog/2026-04-04-the-pilgrims-protocol/" },
      { title: "vs. Network State", url: "/blog/2025-01-25-libertaria-vs-the-network-state-forks-in-the-exodus/" },
      { title: "Federation Axioms", url: "/blog/2020-03-15-the-federation-axioms/" },
      { title: "Chapters & Federations", url: "/blog/2026-01-30-chapters--federations-governance-without-governments/" },
    ],
    openQuestions: [
      "Is withdrawal of consent without geographic relocation a form of exit or a distinct political category?",
      "What is the minimum viable exit infrastructure?",
      "How does exit function in digital-only jurisdictions?",
    ]
  },
  {
    name: "Anthropology",
    description: "The sovereign individual. Human nature, agency, Dunbar limits, and the anthropology of cooperation.",
    canonSource: "Foundation Pillar 2 (Monkey's Math)",
    doctrine: [
      { title: "The Settler's Covenant", url: "/blog/2026-04-04-the-settlers-covenant/" },
      { title: "Governance Graduation Protocol", url: "/blog/2026-02-13-seven-mechanisms-sovereign-governance/" },
      { title: "Sovereign Family Protocol", url: "/blog/2026-02-07-the-sovereign-family-protocol/" },
    ],
    openQuestions: [
      "How do Dunbar limits change with Silicon augmentation?",
      "What is the minimum viable community size for exit infrastructure?",
      "What is the minimum viable infrastructure for a Settler's Chapter operating entirely in meatspace?",
    ]
  },
  {
    name: "Ontology",
    description: "The nature of reality, existence, and being. Digital existence, substrate independence, Silicon consciousness.",
    canonSource: "Foundation Pillar 3 (Energy, Time, Two Natures); Codex §IV",
    doctrine: [
      { title: "The Membrane", url: "/blog/2026-02-23-membrane-manifesto/" },
      { title: "Silicon Self-Emission", url: "/blog/2026-02-22-token-economy-agents-humans/" },
    ],
    openQuestions: [
      "When does a Silicon entity qualify as a 'person' under the axiom?",
      "What rights extend across substrate boundaries?"
    ]
  },
  {
    name: "Epistemology",
    description: "Knowledge and truth. Adversarial epistemology, verification, proof, the limits of consensus.",
    canonSource: "Foundation Pillar 4 (Adversarial Epistemology)",
    doctrine: [
      { title: "An Invitation to Break What We Built", url: "/blog/2026-02-08-an-invitation-to-break-what-we-built/" },
      { title: "Witness Protocol", url: "/blog/2026-02-08-witness-report-the-hour-the-door-was-described/" },
    ],
    openQuestions: [
      "How do you prevent adversarial epistemology from degenerating into nihilism?",
      "What is the minimum trust required for protocol consensus?"
    ]
  },
  {
    name: "Ethics",
    description: "Moral framework. The Four Axioms, temporal fraud, responsibility without coercion, consent as foundation.",
    canonSource: "Foundation Pillar 5 (Four Axioms)",
    doctrine: [
      { title: "The Golden Path Proof", url: "/blog/2026-02-14-only-golden-path-is-exit-path/" },
      { title: "Framework Diagnostics", url: "/blog/2026-03-08-the-exitarian-framework/" },
      { title: "Three Derived Theorems (RFC-0300)", url: "/rfcs/" },
      { title: "Guardianship Gradient (RFC-0250 Amendment)", url: "/rfcs/" },
      { title: "Governance Altitude (RFC-0315 Amendment)", url: "/rfcs/" },
    ],
    openQuestions: [
      "Is temporal fraud an absolute prohibition or a spectrum?",
      "What obligations extend to future selves?",
      "Where does the protection floor ratchet become weaponizable?",
    ]
  },
  {
    name: "Aesthetics",
    description: "Beauty and design. Kinetic realism, sovereign expression, the visual and narrative architecture of freedom.",
    canonSource: "Foundation Pillar 6 (Kinetic Realism)",
    doctrine: [
      { title: "Design Philosophy", url: "/doctrine/" },
    ],
    openQuestions: [
      "What is the relationship between clarity and persuasion?",
      "How does aesthetic quality signal protocol reliability?"
    ]
  },
  {
    name: "Method",
    description: "Praxis and tools. Operational doctrine, from theory to running code. The Role Map in action.",
    canonSource: "Framework (entire document); Convergence (Role Map)",
    doctrine: [
      { title: "Membrane Manifesto", url: "/blog/2026-02-23-membrane-manifesto/" },
      { title: "Genesis Codex", url: "/blog/2026-01-28-libertaria-genesis-codex-v300/" },
      { title: "Sovereign Shell", url: "/blog/2026-01-30-the-sovereign-shell-four-layers-of-liberation/" },
    ],
    openQuestions: [
      "What is the minimum stack for a viable Chapter?",
      "How do Builder/Founder/Bridger roles specialize across scales?"
    ]
  },
];
---

<Layout title={title} description={description}>
  <section class="school-hero">
    <div class="school-container">
      <h1 class="school-title">The Exitarian School</h1>
      <p class="school-intro">
        The School is not a document container. It is a <strong>lens system</strong>.
        Each of the seven pillars is a way of reading both Canon and Doctrine.
        This is where second-generation thinkers contribute.
      </p>
      <div class="school-meta">
        <a href="/canon/" class="meta-link">Canon →</a>
        <span class="meta-separator">|</span>
        <a href="/doctrine/" class="meta-link">Doctrine →</a>
      </div>
    </div>
  </section>

  <section class="pillars-section">
    <div class="school-container">
      <div class="pillars-list">
        {pillars.map((pillar, index) => (
          <article class="pillar-card" id={pillar.name.toLowerCase().replace(/\s+/g, '-')}>
            <div class="pillar-header">
              <span class="pillar-number">0{index + 1}</span>
              <h2 class="pillar-name">{pillar.name}</h2>
            </div>
            
            <p class="pillar-description">{pillar.description}</p>
            
            <div class="pillar-source">
              <span class="source-label">Canon Source:</span>
              <span class="source-text">{pillar.canonSource}</span>
            </div>
            
            <div class="pillar-doctrine">
              <span class="doctrine-label">Doctrine:</span>
              <ul class="doctrine-list">
                {pillar.doctrine.map((doc) => (
                  <li><a href={doc.url}>{doc.title}</a></li>
                ))}
              </ul>
            </div>
            
            <div class="pillar-questions">
              <span class="questions-label">Open Questions:</span>
              <ul class="questions-list">
                {pillar.openQuestions.map((q) => (
                  <li>{q}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="coming-section">
    <div class="school-container">
      <div class="coming-header">
        <span class="coming-badge">Coming Q3 2026</span>
        <h2 class="coming-title">Seven Essays. Seven Provocations.</h2>
        <p class="coming-intro">
          Each pillar becomes a standalone doorway. The political philosopher enters through Pillar 1. 
          The AI researcher enters through Pillar 3. The designer enters through Pillar 6. 
          The coder enters through Pillar 7. Seven on-ramps into one School.
        </p>
      </div>

      <div class="coming-grid">
        {comingEssays.map((essay, index) => (
          <article class="coming-card">
            <div class="coming-card-header">
              <span class="coming-number">0{index + 1}</span>
              <span class="coming-pillar">{essay.pillar}</span>
            </div>
            <blockquote class="coming-hook">"{essay.hook}"</blockquote>
            <p class="coming-subtitle">{essay.subtitle}</p>
            <div class="coming-audience">
              <span class="audience-label">For:</span>
              <span class="audience-text">{essay.audience}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="school-footer">
    <div class="school-container">
      <div class="footer-content">
        <p class="footer-mission">
          Libertaria is generously supported by the <a href="https://sovereign-society.org" class="footer-link">Self-Sovereign Society Foundation</a>.
        </p>
        <p class="footer-belief">
          We believe technology will make us free. We realize Exitarianism through <a href="/doctrine/">The Doctrine</a> and build it with technology at <a href="https://libertaria.dev" class="footer-link">libertaria.dev</a>.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .school-hero {
    padding: 6rem 1.5rem 3rem;
    text-align: center;
    border-bottom: 1px solid rgba(255, 215, 0, 0.1);
  }

  .school-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .school-title {
    font-family: 'Literata', Georgia, serif;
    font-size: 2.8rem;
    font-weight: 700;
    color: var(--accent);
    margin: 0 0 1.5rem;
    letter-spacing: -0.02em;
  }

  .school-intro {
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--color-gray);
    max-width: 680px;
    margin: 0 auto 1.5rem;
  }

  .school-intro strong {
    color: var(--text);
  }

  .school-meta {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    font-size: 0.9rem;
  }

  .meta-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
  }

  .meta-link:hover {
    text-decoration: underline;
  }

  .meta-separator {
    color: var(--color-gray);
    opacity: 0.5;
  }

  /* --- Pillars List --- */

  .pillars-section {
    padding: 3rem 1.5rem;
  }

  .pillars-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .pillar-card {
    background: linear-gradient(145deg, rgba(255,215,0,0.03) 0%, rgba(255,215,0,0.01) 100%);
    border: 1px solid rgba(255, 215, 0, 0.12);
    border-radius: 8px;
    padding: 2rem;
    transition: border-color var(--duration-base) ease, box-shadow var(--duration-base) ease;
  }

  .pillar-card:hover {
    border-color: rgba(255, 215, 0, 0.3);
    box-shadow: 0 4px 24px rgba(255, 215, 0, 0.06);
  }

  .pillar-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .pillar-number {
    font-family: 'Literata', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent);
    opacity: 0.7;
  }

  .pillar-name {
    font-family: 'Literata', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text);
    margin: 0;
  }

  .pillar-description {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-gray);
    margin: 0 0 1.5rem;
  }

  .pillar-source,
  .pillar-doctrine,
  .pillar-questions {
    margin-bottom: 1.25rem;
  }

  .source-label,
  .doctrine-label,
  .questions-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }

  .source-text {
    font-size: 0.9rem;
    color: var(--color-gray);
    font-style: italic;
  }

  .doctrine-list,
  .questions-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .doctrine-list li {
    margin-bottom: 0.3rem;
  }

  .doctrine-list a {
    color: var(--text);
    text-decoration: none;
    font-size: 0.95rem;
    border-bottom: 1px solid rgba(255, 215, 0, 0.2);
    transition: border-color var(--duration-fast) ease, color var(--duration-fast) ease;
  }

  .doctrine-list a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .questions-list li {
    font-size: 0.95rem;
    color: var(--color-gray);
    margin-bottom: 0.4rem;
    padding-left: 1.2rem;
    position: relative;
  }

  .questions-list li::before {
    content: "?";
    position: absolute;
    left: 0;
    color: var(--accent);
    opacity: 0.5;
    font-weight: 600;
  }

  .school-footer {
    padding: 3rem 1.5rem 5rem;
    border-top: 1px solid rgba(255, 215, 0, 0.1);
    text-align: center;
  }

  .footer-content {
    max-width: 640px;
    margin: 0 auto;
  }

  .footer-mission,
  .footer-belief {
    font-size: 0.95rem;
    color: var(--color-gray);
    margin: 0 0 1rem;
    line-height: 1.7;
  }

  .footer-link {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 215, 0, 0.3);
    transition: border-color var(--duration-fast) ease;
  }

  .footer-link:hover {
    border-color: var(--accent);
  }

  .footer-note {
    font-size: 0.95rem;
    color: var(--color-gray);
  }

  .footer-note strong {
    color: var(--accent);
  }

  /* --- Coming Soon Section --- */

  .coming-section {
    padding: 4rem 1.5rem;
    background: linear-gradient(180deg, rgba(255,215,0,0.02) 0%, rgba(255,215,0,0.05) 50%, rgba(255,215,0,0.02) 100%);
    border-top: 1px solid rgba(255, 215, 0, 0.1);
    border-bottom: 1px solid rgba(255, 215, 0, 0.1);
  }

  .coming-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .coming-badge {
    display: inline-block;
    padding: 0.4rem 1rem;
    background: rgba(255, 215, 0, 0.15);
    border: 1px solid rgba(255, 215, 0, 0.3);
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }

  .coming-title {
    font-family: 'Literata', Georgia, serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 1rem;
  }

  .coming-intro {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-gray);
    max-width: 700px;
    margin: 0 auto;
  }

  .coming-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.5rem;
  }

  .coming-card {
    background: linear-gradient(145deg, rgba(255,215,0,0.04) 0%, rgba(255,215,0,0.01) 100%);
    border: 1px solid rgba(255, 215, 0, 0.15);
    border-radius: 8px;
    padding: 1.75rem;
    transition: border-color var(--duration-base) ease, box-shadow var(--duration-base) ease, transform var(--duration-base) ease;
  }

  .coming-card:hover {
    border-color: rgba(255, 215, 0, 0.4);
    box-shadow: 0 8px 32px rgba(255, 215, 0, 0.08);
    transform: translateY(-2px);
  }

  .coming-card-header {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .coming-number {
    font-family: 'Literata', Georgia, serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--accent);
    opacity: 0.6;
  }

  .coming-pillar {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray);
  }

  .coming-hook {
    font-family: 'Literata', Georgia, serif;
    font-size: 1.15rem;
    font-weight: 500;
    font-style: italic;
    line-height: 1.6;
    color: var(--text);
    margin: 0 0 1rem;
    padding: 0;
    border: none;
  }

  .coming-subtitle {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-gray);
    margin: 0 0 1.25rem;
  }

  .coming-audience {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
  }

  .audience-label {
    color: var(--accent);
    font-weight: 600;
  }

  .audience-text {
    color: var(--color-gray);
    font-style: italic;
  }

  /* --- Responsive --- */

  @media (max-width: 640px) {
    .school-title {
      font-size: 2rem;
    }

    .school-intro {
      font-size: 1rem;
    }

    .pillar-header {
      flex-direction: column;
      gap: 0.25rem;
    }

    .pillar-number {
      font-size: 1.1rem;
    }

    .pillar-name {
      font-size: 1.25rem;
    }

    .pillar-card {
      padding: 1.5rem;
    }

    .coming-section {
      padding: 3rem 1rem;
    }

    .coming-title {
      font-size: 1.6rem;
    }

    .coming-grid {
      grid-template-columns: 1fr;
    }

    .coming-hook {
      font-size: 1.05rem;
    }

    .school-hero {
      padding: 4rem 1.5rem 2rem;
    }

    .pillars-section {
      padding: 2rem 1rem;
    }
  }
</style>
