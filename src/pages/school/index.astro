---
import Layout from '../../layouts/Layout.astro';

const title = "The Exitarian School";
const description = "Seven pillars of inquiry into exit, sovereignty, and the mechanisms of freedom.";

const pillars = [
  {
    name: "Political Philosophy",
    description: "Exit as political act. Sovereignty, statelessness, the right to leave.",
  },
  {
    name: "Anthropology",
    description: "The sovereign individual. Human nature, agency, family as protocol.",
  },
  {
    name: "Ontology",
    description: "The nature of reality. Digital existence, substrate independence, AI consciousness.",
  },
  {
    name: "Epistemology",
    description: "Knowledge and truth. Verification, proof, the limits of consensus.",
  },
  {
    name: "Ethics",
    description: "Moral framework. Responsibility without coercion, consent as foundation.",
  },
  {
    name: "Aesthetics",
    description: "Beauty and design. Sovereign expression, the architecture of freedom.",
  },
  {
    name: "Method",
    description: "Praxis and tools. Operational doctrine, from theory to running code.",
  },
];
---

<Layout title={title} description={description}>
  <section class="school-hero">
    <div class="school-container">
      <h1 class="school-title">The Exitarian School</h1>
      <p class="school-intro">
        Exitarianism holds that the primary mechanism of governance is not voice, but exit.
        Systems are disciplined not by complaint, but by the credible threat of departure.
        The Exitarian School organizes this insight into seven pillars of inquiry.
      </p>
    </div>
  </section>

  <section class="pillars-section">
    <div class="school-container">
      <div class="pillars-grid">
        {pillars.map((pillar) => (
          <article class="pillar-card">
            <h2 class="pillar-name">{pillar.name}</h2>
            <p class="pillar-description">{pillar.description}</p>
            <span class="pillar-badge">Coming Q3 2026</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="school-nav">
    <div class="school-container">
      <div class="nav-links">
        <a href="/canon/" class="nav-link">
          <span class="nav-link-label">Read the foundational texts</span>
          <span class="nav-link-arrow">&rarr;</span>
        </a>
        <a href="/doctrine/" class="nav-link">
          <span class="nav-link-label">See how we build the philosophy</span>
          <span class="nav-link-arrow">&rarr;</span>
        </a>
        <a href="/essays/" class="nav-link">
          <span class="nav-link-label">Explore the commentary</span>
          <span class="nav-link-arrow">&rarr;</span>
        </a>
        <a href="/school/paths/" class="nav-link">
          <span class="nav-link-label">Follow a guided reading path</span>
          <span class="nav-link-arrow">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .school-hero {
    padding: 6rem 1.5rem 3rem;
    text-align: center;
    border-bottom: 1px solid rgba(255, 215, 0, 0.1);
  }

  .school-container {
    max-width: 960px;
    margin: 0 auto;
  }

  .school-title {
    font-family: 'Literata', Georgia, serif;
    font-size: 2.8rem;
    font-weight: 700;
    color: var(--color-gold);
    margin: 0 0 1.5rem;
    letter-spacing: -0.02em;
  }

  .school-intro {
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--color-white-dim);
    max-width: 720px;
    margin: 0 auto;
  }

  /* --- Pillars Grid --- */

  .pillars-section {
    padding: 4rem 1.5rem;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .pillar-card {
    background: linear-gradient(145deg, var(--color-black-lighter) 0%, var(--color-black-light) 100%);
    border: 1px solid rgba(255, 215, 0, 0.12);
    border-radius: 12px;
    padding: 2rem;
    transition: border-color var(--duration-base) var(--ease-out-expo),
                box-shadow var(--duration-base) var(--ease-out-expo);
  }

  .pillar-card:hover {
    border-color: rgba(255, 215, 0, 0.35);
    box-shadow: 0 4px 24px rgba(255, 215, 0, 0.08);
  }

  .pillar-name {
    font-family: 'Literata', Georgia, serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-gold);
    margin: 0 0 0.75rem;
  }

  .pillar-description {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-white-dim);
    margin: 0 0 1rem;
  }

  .pillar-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-gray);
    background: rgba(136, 136, 136, 0.12);
    border: 1px solid rgba(136, 136, 136, 0.2);
    border-radius: 4px;
    padding: 0.2rem 0.6rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  /* --- Bottom Navigation --- */

  .school-nav {
    padding: 3rem 1.5rem 5rem;
    border-top: 1px solid rgba(255, 215, 0, 0.1);
  }

  .nav-links {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 480px;
    margin: 0 auto;
  }

  .nav-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    background: var(--color-black-light);
    border: 1px solid rgba(255, 215, 0, 0.1);
    border-radius: 8px;
    text-decoration: none;
    color: var(--color-white-dim);
    transition: border-color var(--duration-base) var(--ease-out-expo),
                color var(--duration-base) var(--ease-out-expo);
  }

  .nav-link:hover {
    border-color: var(--color-gold);
    color: var(--color-gold);
  }

  .nav-link:visited {
    color: var(--color-white-dim);
  }

  .nav-link:visited:hover {
    color: var(--color-gold);
  }

  .nav-link-label {
    font-size: 1rem;
    font-weight: 500;
  }

  .nav-link-arrow {
    font-size: 1.2rem;
    color: var(--color-gold);
    opacity: 0.6;
    transition: opacity var(--duration-fast) ease, transform var(--duration-fast) ease;
  }

  .nav-link:hover .nav-link-arrow {
    opacity: 1;
    transform: translateX(4px);
  }

  /* --- Responsive --- */

  @media (max-width: 680px) {
    .school-title {
      font-size: 2rem;
    }

    .school-intro {
      font-size: 1rem;
    }

    .pillars-grid {
      grid-template-columns: 1fr;
    }

    .school-hero {
      padding: 4rem 1.5rem 2rem;
    }

    .pillars-section {
      padding: 2.5rem 1.5rem;
    }
  }
</style>
