---
import Layout from '../../../layouts/Layout.astro';

const title = "Reading Paths";
const description = "Curated journeys through the Exitarian School.";

const essentialFive = [
  {
    title: "Libertaria in 5 Minutes",
    href: "/blog/2026-02-05-libertaria-executive-digest/",
  },
  {
    title: "The Four Pillars of a Decentralized Society",
    href: "/blog/2017-10-01-the-four-pillars-of-a-decentralized-society/",
  },
  {
    title: "The Exit Protocol",
    href: "/blog/2026-02-04-exit-protocol/",
  },
  {
    title: "The Membrane Manifesto",
    href: "/blog/2026-02-23-membrane-manifesto/",
  },
  {
    title: "An Invitation to Break What We Built",
    href: "/blog/2026-02-08-an-invitation-to-break-what-we-built/",
  },
];

const politicalThread = [
  {
    title: "The Architecture of Exit Denial",
    href: "/blog/2026-02-01-the-architecture-of-exit-denial-how-financial-crises-reveal-the-true-nature-of-money/",
  },
  {
    title: "The Death of the Freehold",
    href: "/blog/2026-02-01-the-death-of-the-freehold-how-ownership-became-a-subscription-service/",
  },
  {
    title: "The Great Capture",
    href: "/blog/2026-02-05-the-great-capture/",
  },
  {
    title: "The Sovereign Shell",
    href: "/blog/2026-01-30-the-sovereign-shell-four-layers-of-liberation/",
  },
  {
    title: "The Conspiracy of -isms",
    href: "/blog/2026-01-29-the-conspiracy-of--isms-how-capital-and-communism-danced-while-we-picked-sides/",
  },
];
---

<Layout title={title} description={description}>
  <section class="paths-hero">
    <div class="paths-container">
      <h1 class="paths-title">Reading Paths</h1>
      <p class="paths-subtitle">Curated journeys through the Exitarian School.</p>
    </div>
  </section>

  <section class="paths-section">
    <div class="paths-container">

      <!-- Path 1: Start Here -->
      <article class="path-block">
        <div class="path-header">
          <span class="path-number">I</span>
          <div>
            <h2 class="path-name">"Start Here" &mdash; The Essential Five</h2>
            <p class="path-description">The minimum viable understanding. Five texts that lay the foundation.</p>
          </div>
        </div>
        <ol class="path-list">
          {essentialFive.map((item) => (
            <li class="path-item">
              <a href={item.href}>{item.title}</a>
            </li>
          ))}
        </ol>
      </article>

      <!-- Path 2: Go Deeper -->
      <article class="path-block">
        <div class="path-header">
          <span class="path-number">II</span>
          <div>
            <h2 class="path-name">"Go Deeper" &mdash; The Political Thread</h2>
            <p class="path-description">How exit denial operates. Finance, property, capture, and the architecture of control.</p>
          </div>
        </div>
        <ol class="path-list">
          {politicalThread.map((item) => (
            <li class="path-item">
              <a href={item.href}>{item.title}</a>
            </li>
          ))}
        </ol>
      </article>

      <!-- Path 3: Full Canon -->
      <article class="path-block path-block-canon">
        <div class="path-header">
          <span class="path-number">III</span>
          <div>
            <h2 class="path-name">"The Full Canon"</h2>
            <p class="path-description">All 11 foundational texts, in order. The complete intellectual architecture.</p>
          </div>
        </div>
        <div class="canon-cta">
          <a href="/canon/" class="canon-link">
            <span>Read all 11 foundational texts in order</span>
            <span class="canon-arrow">&rarr;</span>
          </a>
        </div>
      </article>

    </div>
  </section>

  <section class="paths-footer">
    <div class="paths-container">
      <a href="/school/" class="back-link">&larr; Back to The Exitarian School</a>
    </div>
  </section>
</Layout>

<style>
  .paths-hero {
    padding: 6rem 1.5rem 3rem;
    text-align: center;
    border-bottom: 1px solid rgba(255, 215, 0, 0.1);
  }

  .paths-container {
    max-width: 760px;
    margin: 0 auto;
  }

  .paths-title {
    font-family: 'Literata', Georgia, serif;
    font-size: 2.8rem;
    font-weight: 700;
    color: var(--color-gold);
    margin: 0 0 0.75rem;
    letter-spacing: -0.02em;
  }

  .paths-subtitle {
    font-size: 1.15rem;
    color: var(--color-gray);
    margin: 0;
  }

  /* --- Path Blocks --- */

  .paths-section {
    padding: 4rem 1.5rem;
  }

  .path-block {
    margin-bottom: 3rem;
    padding: 2rem 2.5rem;
    background: linear-gradient(145deg, var(--color-black-lighter) 0%, var(--color-black-light) 100%);
    border: 1px solid rgba(255, 215, 0, 0.12);
    border-radius: 12px;
  }

  .path-header {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .path-number {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    font-family: 'Literata', Georgia, serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-gold);
    border: 2px solid var(--color-gold);
    border-radius: 50%;
    margin-top: 0.15rem;
  }

  .path-name {
    font-family: 'Literata', Georgia, serif;
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--color-white-dim);
    margin: 0 0 0.35rem;
  }

  .path-description {
    font-size: 0.9rem;
    color: var(--color-gray);
    margin: 0;
    line-height: 1.5;
  }

  /* --- Numbered List --- */

  .path-list {
    list-style: none;
    counter-reset: path-counter;
    padding: 0;
    margin: 0;
  }

  .path-item {
    counter-increment: path-counter;
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(255, 215, 0, 0.06);
  }

  .path-item:last-child {
    border-bottom: none;
  }

  .path-item::before {
    content: counter(path-counter);
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.6rem;
    height: 1.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-gold);
    background: rgba(255, 215, 0, 0.08);
    border-radius: 50%;
  }

  .path-item a {
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-white-dim);
    text-decoration: underline;
    text-decoration-color: rgba(255, 26, 26, 0.3);
    transition: color var(--duration-fast) ease, text-decoration-color var(--duration-fast) ease;
  }

  .path-item a:hover {
    color: var(--color-gold);
    text-decoration-color: var(--color-gold);
  }

  /* --- Canon CTA --- */

  .path-block-canon {
    border-color: rgba(255, 215, 0, 0.25);
  }

  .canon-cta {
    margin-top: 0.5rem;
  }

  .canon-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    background: rgba(255, 215, 0, 0.06);
    border: 1px solid rgba(255, 215, 0, 0.2);
    border-radius: 8px;
    text-decoration: none;
    color: var(--color-gold);
    font-weight: 500;
    font-size: 1rem;
    transition: background var(--duration-base) var(--ease-out-expo),
                border-color var(--duration-base) var(--ease-out-expo);
  }

  .canon-link:hover {
    background: rgba(255, 215, 0, 0.1);
    border-color: var(--color-gold);
  }

  .canon-link:visited {
    color: var(--color-gold);
  }

  .canon-arrow {
    font-size: 1.2rem;
    transition: transform var(--duration-fast) ease;
  }

  .canon-link:hover .canon-arrow {
    transform: translateX(4px);
  }

  /* --- Footer Nav --- */

  .paths-footer {
    padding: 2rem 1.5rem 5rem;
    border-top: 1px solid rgba(255, 215, 0, 0.1);
  }

  .back-link {
    font-size: 0.9rem;
    color: var(--color-gray);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .back-link:hover {
    color: var(--color-gold);
  }

  .back-link:visited {
    color: var(--color-gray);
  }

  .back-link:visited:hover {
    color: var(--color-gold);
  }

  /* --- Responsive --- */

  @media (max-width: 680px) {
    .paths-title {
      font-size: 2rem;
    }

    .paths-hero {
      padding: 4rem 1.5rem 2rem;
    }

    .paths-section {
      padding: 2.5rem 1.5rem;
    }

    .path-block {
      padding: 1.5rem;
    }

    .path-header {
      gap: 1rem;
    }

    .path-number {
      width: 2rem;
      height: 2rem;
      font-size: 0.9rem;
    }

    .path-name {
      font-size: 1.15rem;
    }
  }
</style>
