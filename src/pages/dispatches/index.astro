---
import LandingLayout from '../../layouts/LandingLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const now = new Date();
const lanePosts = posts
  .filter(p => p.data.editorial_lane === 'dispatches' && p.data.pubDate <= now)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<LandingLayout title="Dispatches | Libertaria" description="Trench reports from the parallel. Big tech enclosure, platform capture, chapter operations, and how Libertaria fights back.">
  <section class="lane-page">
    <header class="lane-header">
      <div class="lane-rule"></div>
      <h1>Dispatches</h1>
      <p class="lane-subtitle">
        Trench reports from the parallel.<br />
        Big tech enclosure, platform capture, chapter operations, and how Libertaria fights back.
      </p>
    </header>
    {lanePosts.length === 0 ? (
      <div class="empty-state">
        <p>No dispatches yet. The front is moving fast.</p>
        <p class="hint">Check back soon.</p>
      </div>
    ) : (
      <div class="post-grid">
        {lanePosts.map((post) => (
          <article class="post-card">
            <a href={`/blog/${post.slug}/`}>
              <div class="post-card-date">
                {post.data.pubDate.toLocaleDateString('en-us', { month: 'short', day: 'numeric', year: 'numeric' })}
                <span class="author-pill">{post.data.author}</span>
              </div>
              <h3>{post.data.title}</h3>
              <p class="post-card-desc">{post.data.description}</p>
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="post-card-tags">
                  {post.data.tags.slice(0, 3).map(tag => <span class="tag">#{tag}</span>)}
                </div>
              )}
            </a>
          </article>
        ))}
      </div>
    )}
  </section>
</LandingLayout>
<style>
  .lane-page { max-width: 1100px; margin: 0 auto; padding: 3rem 1rem; }
  .lane-header { text-align: center; margin-bottom: 3rem; }
  .lane-rule { width: 60px; height: 3px; background: var(--color-gold); margin: 0 auto 1.5rem; }
  .lane-header h1 { font-size: 3rem; color: var(--color-gold); margin-bottom: 0.5rem; }
  .lane-subtitle { font-size: 1.1rem; color: var(--color-gray); max-width: 520px; margin: 0 auto; line-height: 1.6; }
  .post-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem; }
  .post-card { background: var(--color-black-lighter); border: 1px solid rgba(255,215,0,0.1); border-radius: 12px; overflow: hidden; transition: border-color 0.3s ease, box-shadow 0.3s ease; }
  .post-card:hover { border-color: rgba(255,215,0,0.4); box-shadow: 0 0 20px rgba(255,215,0,0.06); }
  .post-card a { display: block; padding: 1.5rem; text-decoration: none; }
  .post-card-date { font-size: 0.8rem; color: var(--color-gray); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem; }
  .author-pill { background: rgba(255,215,0,0.15); color: var(--color-gold); padding: 0.1rem 0.5rem; border-radius: 4px; font-size: 0.75rem; }
  .post-card h3 { font-size: 1.15rem; color: var(--text); margin-bottom: 0.5rem; line-height: 1.3; }
  .post-card:hover h3 { color: var(--color-gold); }
  .post-card-desc { font-size: 0.9rem; color: var(--color-gray); line-height: 1.5; margin-bottom: 0.75rem; }
  .post-card-tags { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .tag { font-size: 0.75rem; color: rgba(255,215,0,0.6); }
  .empty-state { text-align: center; padding: 4rem; color: var(--color-gray); }
  .empty-state p { margin-bottom: 0.5rem; }
  .hint { font-size: 0.85rem; opacity: 0.6; }
</style>
