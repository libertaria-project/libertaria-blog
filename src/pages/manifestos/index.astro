---
import LandingLayout from '../../layouts/LandingLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const now = new Date();
const lanePosts = posts
  .filter(p => p.data.editorial_lane === 'manifestos' && p.data.pubDate <= now)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<LandingLayout title="Manifestos | Libertaria" description="Blade texts. High-voltage polemics. The rattling manifests that draw the line.">
  <section class="lane-page">
    <header class="lane-header">
      <div class="lane-rule"></div>
      <h1>Manifestos</h1>
      <p class="lane-subtitle">
        Blade texts. High-voltage polemics.<br />
        The rattling manifests that draw the line.
      </p>
    </header>
    {lanePosts.length === 0 ? (
      <div class="empty-state">
        <p>The blade is being sharpened.</p>
        <p class="hint">Check back soon.</p>
      </div>
    ) : (
      <div class="manifesto-list">
        {lanePosts.map((post) => (
          <article class="manifesto-item">
            <a href={`/blog/${post.slug}/`} class="manifesto-link">
              <div class="manifesto-meta">
                <span class="manifesto-date">
                  {post.data.pubDate.toLocaleDateString('en-us', { month: 'short', day: 'numeric', year: 'numeric' })}
                </span>
                <span class="author-pill">{post.data.author}</span>
              </div>
              <h3 class="manifesto-title">{post.data.title}</h3>
              <p class="manifesto-desc">{post.data.description}</p>
            </a>
          </article>
        ))}
      </div>
    )}
  </section>
</LandingLayout>
<style>
  .lane-page { max-width: 800px; margin: 0 auto; padding: 3rem 1rem; }
  .lane-header { text-align: center; margin-bottom: 3rem; }
  .lane-rule { width: 60px; height: 3px; background: var(--color-gold); margin: 0 auto 1.5rem; }
  .lane-header h1 { font-size: 3rem; color: var(--color-gold); margin-bottom: 0.5rem; }
  .lane-subtitle { font-size: 1.1rem; color: var(--color-gray); max-width: 440px; margin: 0 auto; line-height: 1.6; }
  .manifesto-list { display: flex; flex-direction: column; gap: 0; }
  .manifesto-item { border-bottom: 1px solid rgba(255,215,0,0.1); }
  .manifesto-link { display: block; padding: 2rem 0; text-decoration: none; transition: padding-left 0.3s ease; }
  .manifesto-item:first-child { border-top: 1px solid rgba(255,215,0,0.1); }
  .manifesto-link:hover { padding-left: 1rem; }
  .manifesto-link:hover .manifesto-title { color: var(--color-gold); }
  .manifesto-meta { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem; }
  .manifesto-date { font-size: 0.8rem; color: var(--color-gray); }
  .author-pill { background: rgba(255,215,0,0.15); color: var(--color-gold); padding: 0.1rem 0.5rem; border-radius: 4px; font-size: 0.75rem; }
  .manifesto-title { font-size: 1.4rem; color: var(--text); margin-bottom: 0.5rem; line-height: 1.3; transition: color 0.3s ease; }
  .manifesto-desc { font-size: 0.9rem; color: var(--color-gray); line-height: 1.6; }
  .empty-state { text-align: center; padding: 4rem; color: var(--color-gray); }
  .hint { font-size: 0.85rem; opacity: 0.6; }
</style>
