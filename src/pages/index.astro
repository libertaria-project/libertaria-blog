---
import LandingLayout from '../layouts/LandingLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const now = new Date();
const publishedPosts = posts.filter(p => p.data.pubDate <= now);
publishedPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const essays = publishedPosts;

const latestEssays = essays.slice(0, 10);
const featured = latestEssays[0];
const regular = latestEssays.slice(1, 10);

// Latest Developments — only on libertaria.dev
const isDev = Astro.url.hostname === 'libertaria.dev';
const milestonePosts = isDev
	? publishedPosts.filter(p => p.data.category === 'milestone').slice(0, 5)
	: [];

// Build tag cloud from published posts, sorted by frequency
const tagCounts = new Map();
essays.forEach(p => {
	(p.data.tags || []).forEach(tag => {
		const normalized = tag.replace(/^["']|["']$/g, '').toLowerCase();
		tagCounts.set(normalized, (tagCounts.get(normalized) || 0) + 1);
	});
});
const topTags = [...tagCounts.entries()]
	.sort((a, b) => b[1] - a[1])
	.slice(0, 8)
	.map(([tag]) => tag);
---

