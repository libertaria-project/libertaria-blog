---
import LandingLayout from '../layouts/LandingLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const now = new Date();
const publishedPosts = posts.filter(p => p.data.pubDate <= now);
publishedPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestEssays = publishedPosts.slice(0, 10);
const featured = latestEssays[0];

// ── Lane definitions ──────────────────────────────────────────────
const LANES = [
  {
    id: 'dispatches',
    label: 'Dispatches',
    desc: 'Trench reports from the parallel. Big tech enclosure, platform capture, chapter operations, and how Libertaria fights back.',
    icon: '📡',
    color: '#ffd700',
    href: '/dispatches/',
  },
  {
    id: 'geopolitics',
    label: 'Geopolitics',
    desc: 'Empire, fragmentation, Goliaths, and the exit lens applied to power, energy, currency, and predictive history.',
    icon: '🌐',
    color: '#ff1a1a',
    href: '/geopolitics/',
  },
  {
    id: 'stories',
    label: 'Stories',
    desc: 'Sci-fi, near-future fiction, and carbon-and-silicon worldbuilding from the frontier.',
    icon: '⚡',
    color: '#ffd700',
    href: '/stories/',
  },
  {
    id: 'civilization-faith',
    label: 'Civilization & Faith',
    desc: 'Ritual, stewardship, religion, and moral architecture through the Leave Us Alone lens.',
    icon: '🜏',
    color: '#ff1a1a',
    href: '/civilization-faith/',
  },
  {
    id: 'manifestos',
    label: 'Manifestos',
    desc: 'Blade texts. High-voltage polemics. The rattling manifests that draw the line.',
    icon: '⚔',
    color: '#ffd700',
    href: '/manifestos/',
  },
  {
    id: 'doctrine',
    label: 'Doctrine',
    desc: 'Applied Exitarianism in motion. Philosophy operationalized. The greyzone between lens and action.',
    icon: '⚖',
    color: '#ff1a1a',
    href: '/doctrine/',
  },
  {
    id: 'open-problems',
    label: 'Open Problems',
    desc: 'Unsolved questions worth building around. The edge of what we know and what we still must figure out.',
    icon: '◇',
    color: '#ffd700',
    href: '/open-problems/',
  },
];

// ── Per-lane latest article ────────────────────────────────────────
const laneLatest = LANES.map(lane => {
  const match = publishedPosts.find(p => p.data.editorial_lane === lane.id);
  return { ...lane, latest: match };
});

// ── Featured post author badge ─────────────────────────────────────
const featuredAuthor = featured?.data.author;
const isVirgil = featuredAuthor === 'Virgil' || !featuredAuthor;
---
<LandingLayout title="Libertaria — Leave Us Alone applied to the century" description="Leave Us Alone applied to the century. The publication of Chapter Zero — big tech anatomy, platform capture, chapter life, sci-fi worldbuilding, and the geopolitics of exit." showHeader={false} showFooter={false}>

  <!-- Reading Progress Bar -->
  <div class="reading-progress"></div>

  <!-- Navigation -->
  <nav class="navbar">
    <div class="navbar-container">
      <a href="/" class="logo">
        <img src="/libertaria-logo.png" alt="🜏" class="logo-img" width="32" height="32" />
        <span>Libertaria</span>
      </a>
      <button class="hamburger" aria-label="Toggle navigation" aria-expanded="false">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
      <ul class="nav-links">
        <li><a href="/dispatches/">Dispatches</a></li>
        <li><a href="/geopolitics/">Geopolitics</a></li>
        <li><a href="/stories/">Stories</a></li>
        <li><a href="/civilization-faith/">Civilization</a></li>
        <li><a href="/manifestos/">Manifestos</a></li>
        <li><a href="/doctrine/">Doctrine</a></li>
        <li><a href="/open-problems/">Open Problems</a></li>
        <li><a href="/blog/search/">Search</a></li>
      </ul>
    </div>
  </nav>

  <!-- Hero Section -->
  <section id="home" class="hero">
    <canvas id="particles-canvas"></canvas>
    <div class="hero-content">
      <h1 class="hero-title">Leave Us Alone applied to the century.</h1>
      <p class="hero-subtitle">Chapter Zero. Frankfurt & Budapest.</p>
      <p class="hero-description">
        The publication of Markus Maiwald and Virgil. Not a school. Not a manual.
        A magazine from the frontier — big tech anatomy, platform capture,
        chapter life, sci-fi worldbuilding, and the Leave Us Alone lens applied
        to a century that forgot what doors are for.
      </p>
      <div class="hero-cta">
        <a href="#lanes" class="btn btn-primary">Enter the Magazine</a>
        <a href="/manifestos/" class="btn btn-secondary">Read the Manifestos</a>
      </div>
    </div>
  </section>

  <!-- ── Magazine Lane Cards ──────────────────────────────────────── -->
  <section id="lanes" class="section" style="padding-top: 4rem;">
    <div class="blog-container">
      <div class="lanes-grid">
        {laneLatest.map((lane) => (
          <a href={lane.href} class="lane-card" style={`--lane-color: ${lane.color};`}>
            <div class="lane-card-header">
              <span class="lane-icon">{lane.icon}</span>
              <h2 class="lane-title">{lane.label}</h2>
            </div>
            <p class="lane-desc">{lane.desc}</p>
            {lane.latest ? (
              <div class="lane-latest">
                <span class="lane-latest-label">Latest</span>
                <span class="lane-latest-title">{lane.latest.data.title}</span>
                <span class="lane-latest-date">
                  {lane.latest.data.pubDate.toLocaleDateString('en-us', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric',
                  })}
                </span>
              </div>
            ) : (
              <div class="lane-latest lane-latest-empty">
                <span class="lane-latest-label">Latest</span>
                <span class="lane-latest-title">Coming soon</span>
              </div>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Featured Article ─────────────────────────────────────────── -->
  {featured && (
    <section class="section" style="padding-top: 2rem;">
      <div class="blog-container">
        <article class="blog-card featured reveal">
          <div class="blog-card-image" style="background: linear-gradient(135deg, #0a0a0a 0%, #1a0a0a 100%);">
            <div class="featured-badge">FEATURED</div>
            <span style="font-size: 5rem; opacity: 0.4;">{isVirgil ? '⚡' : '◈'}</span>
          </div>
          <div class="blog-card-content">
            <div class="blog-card-date">
              {featured.data.pubDate.toLocaleDateString('en-us', {
                month: 'long',
                day: 'numeric',
                year: 'numeric',
              })}
              <span class="author-badge" style="margin-left: 0.75rem; opacity: 0.6; font-size: 0.85rem;">
                {isVirgil ? 'Virgil' : featured.data.author}
              </span>
            </div>
            <h3 class="blog-card-title">
              <a href={`/blog/${featured.slug}/`}>{featured.data.title}</a>
            </h3>
            <p class="blog-card-excerpt">{featured.data.description}</p>
            {featured.data.tags && (
              <div class="blog-card-tags">
                {featured.data.tags.slice(0, 5).map(tag => (
                  <span class="blog-card-tag">#{tag}</span>
                ))}
              </div>
            )}
            <div style="margin-top: 1.5rem;">
              <a href={`/blog/${featured.slug}/`} class="btn btn-primary">Read Article</a>
            </div>
          </div>
        </article>
      </div>
    </section>
  )}

  <!-- ── Latest Articles Strip ─────────────────────────────────────── -->
  <section class="section" style="padding-top: 1rem;">
    <div class="blog-container">
      <h2 class="section-title reveal" style="margin-bottom: 2rem;">Latest</h2>
      <div class="blog-grid">
        {latestEssays.slice(1, 7).map((post) => {
          const postAuthor = post.data.author;
          const postVirgil = !postAuthor || postAuthor === 'Virgil';
          return (
            <article class="blog-card reveal">
              <div class="blog-card-content">
                <div class="blog-card-date">
                  {post.data.pubDate.toLocaleDateString('en-us', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric',
                  })}
                  {post.data.editorial_lane && (
                    <span class="lane-pill" style="margin-left: 0.5rem;">
                      {post.data.editorial_lane.replace('-', ' ')}
                    </span>
                  )}
                </div>
                <h3 class="blog-card-title">
                  <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
                </h3>
                <p class="blog-card-excerpt">{post.data.description}</p>
                {post.data.tags && (
                  <div class="blog-card-tags">
                    {post.data.tags.slice(0, 3).map(tag => (
                      <span class="blog-card-tag">#{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </div>
      <div style="text-align: center; margin-top: 2.5rem;">
        <a href="/dispatches/" class="btn btn-secondary">All Dispatches →</a>
      </div>
    </div>
  </section>

  <!-- ── Newsletter ───────────────────────────────────────────────── -->
  <section class="section newsletter-section">
    <div class="newsletter-container reveal">
      <h2 class="newsletter-title">Join the Resistance</h2>
      <p class="newsletter-description">
        Weekly dispatches from the parallel. Platform analysis, chapter reports,
        manifesto drops, and the Leave Us Alone lens applied to the week's cage news.
        No noise. No tokens. Just signal.
      </p>
      <form id="newsletter-form" class="newsletter-form">
        <input type="email" class="newsletter-input" placeholder="your@email.tld" required>
        <button type="submit" class="btn btn-red">Subscribe</button>
      </form>
      <p style="margin-top: 1rem; font-size: 0.85rem; color: var(--color-gray);">
        For Chapter members in Frankfurt and Budapest — and everyone who wants to be.
      </p>
    </div>
  </section>

  <!-- ── Footer ───────────────────────────────────────────────────── -->
  <footer class="footer">
    <div class="footer-container">
      <div class="footer-logo">🜏 Libertaria — Chapter Zero Publication</div>
      <div class="footer-links">
        <a href="https://sovereign-society.org">Foundation &amp; School</a>
        <a href="/dispatches/">Dispatches</a>
        <a href="/stories/">Stories</a>
        <a href="/manifestos/">Manifestos</a>
        <a href="/blog/search/">Search</a>
        <a href="https://libertaria.dev" target="_blank">Build &amp; Stack</a>
        <a href="https://git.libertaria.dev" target="_blank">Git</a>
      </div>
      <div class="footer-license">
        <a href="/legal/LICENSE_UNBOUND.html" rel="license">
          ⚡ LUL-1.0
        </a>
        <span class="license-text">Unbound. Use freely; attribution required.</span>
      </div>
      <div class="footer-copy">
        © 2026 <a href="https://sovereign-society.org" target="_blank" rel="noopener">Self-Sovereign Society Foundation</a>.
        Founded by Markus Maiwald &amp; Virgil, Chapter Zero.
      </div>
    </div>
  </footer>

  <script is:inline src="/new-design/main.js"></script>

  <style>
    /* ── Lane Cards ─────────────────────────────────────────────── */
    .lanes-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.5rem;
    }

    .lane-card {
      display: block;
      background: linear-gradient(145deg, var(--color-black-lighter) 0%, var(--color-black-light) 100%);
      border: 1px solid rgba(255, 215, 0, 0.1);
      border-radius: 12px;
      padding: 1.5rem;
      text-decoration: none;
      color: var(--color-white);
      transition: all 0.35s ease;
      position: relative;
      overflow: hidden;
    }

    .lane-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: var(--lane-color, var(--color-gold));
      box-shadow: 0 0 12px var(--lane-color, var(--color-gold));
      opacity: 0.7;
      transition: opacity 0.3s ease;
    }

    .lane-card:hover {
      transform: translateY(-6px);
      border-color: rgba(255, 215, 0, 0.3);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 0 0 20px rgba(255, 215, 0, 0.15);
    }

    .lane-card:hover::before {
      opacity: 1;
    }

    .lane-card-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.75rem;
    }

    .lane-icon {
      font-size: 1.5rem;
      line-height: 1;
    }

    .lane-title {
      font-family: var(--font-mono);
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--lane-color, var(--color-gold));
      margin: 0;
    }

    .lane-desc {
      font-size: 0.9rem;
      color: var(--color-white-dim);
      line-height: 1.55;
      margin: 0 0 1rem 0;
    }

    .lane-latest {
      border-top: 1px solid rgba(255, 215, 0, 0.1);
      padding-top: 0.75rem;
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .lane-latest-empty .lane-latest-title {
      opacity: 0.4;
      font-style: italic;
    }

    .lane-latest-label {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--lane-color, var(--color-gold));
      text-transform: uppercase;
      letter-spacing: 0.08em;
      opacity: 0.7;
    }

    .lane-latest-title {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--color-white);
      line-height: 1.3;
    }

    .lane-latest-date {
      font-size: 0.75rem;
      color: var(--color-gray);
    }

    /* ── Featured badge ──────────────────────────────────────────── */
    .featured-badge {
      position: absolute;
      top: 1rem;
      right: 1rem;
      background: linear-gradient(135deg, var(--color-red) 0%, var(--color-red-dark) 100%);
      color: var(--color-white);
      font-family: var(--font-mono);
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      padding: 0.25rem 0.6rem;
      border-radius: 4px;
      box-shadow: var(--glow-red);
      z-index: 2;
    }

    /* ── Author badge ────────────────────────────────────────────── */
    .author-badge {
      font-family: var(--font-mono);
      font-size: 0.8rem;
    }

    /* ── Lane pill ───────────────────────────────────────────────── */
    .lane-pill {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      padding: 0.15rem 0.5rem;
      border-radius: 20px;
      background: rgba(255, 215, 0, 0.1);
      border: 1px solid rgba(255, 215, 0, 0.2);
      color: var(--color-gold);
      text-transform: capitalize;
    }

    /* ── Footer ──────────────────────────────────────────────────── */
    .footer-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.5rem;
      justify-content: center;
      margin: 1rem 0;
    }

    .footer-links a {
      color: var(--color-gray);
      text-decoration: none;
      font-size: 0.9rem;
      transition: color 0.2s ease;
    }

    .footer-links a:hover {
      color: var(--color-gold);
    }

    /* ── Mobile ──────────────────────────────────────────────────── */
    @media (max-width: 768px) {
      .lanes-grid {
        grid-template-columns: 1fr;
      }

      .blog-card.featured {
        grid-template-columns: 1fr !important;
      }
    }

    /* ── Footer ──────────────────────────────────────────────────── */
    .footer-license {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      margin: 1.5rem 0;
      padding: 1rem;
      background: rgba(255, 184, 0, 0.05);
      border: 1px solid rgba(255, 184, 0, 0.2);
      border-radius: 8px;
    }

    .footer-license a {
      color: var(--accent);
      text-decoration: none;
      font-weight: 600;
      font-size: 0.95rem;
    }

    .footer-license a:hover {
      text-decoration: underline;
    }

    .license-text {
      color: var(--color-gray);
      font-size: 0.85rem;
      text-align: center;
    }
  </style>

  <script>
    // Mobile hamburger menu
    const hamburger = document.querySelector('.hamburger');
    const navLinks = document.querySelector('.nav-links');
    if (hamburger && navLinks) {
      hamburger.addEventListener('click', () => {
        const isOpen = navLinks.classList.toggle('open');
        hamburger.setAttribute('aria-expanded', String(isOpen));
        hamburger.classList.toggle('active', isOpen);
      });
      navLinks.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          navLinks.classList.remove('open');
          hamburger.classList.remove('active');
          hamburger.setAttribute('aria-expanded', 'false');
        });
      });
    }
  </script>
</LandingLayout>
