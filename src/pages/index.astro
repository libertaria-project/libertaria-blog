	<style>
		.footer-license {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 0.5rem;
			margin: 1.5rem 0;
			padding: 1rem;
			background: rgba(255, 184, 0, 0.05);
			border: 1px solid rgba(255, 184, 0, 0.2);
			border-radius: 8px;
		}
		
		.footer-license a {
			color: var(--accent);
			text-decoration: none;
			font-weight: 600;
			font-size: 0.95rem;
		}
		
		.footer-license a:hover {
			text-decoration: underline;
		}
		
		.license-text {
			color: var(--color-gray);
			font-size: 0.85rem;
			text-align: center;
