---
import LandingLayout from '../../layouts/LandingLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const now = new Date();
const lanePosts = posts
  .filter(p => p.data.editorial_lane === 'civilization-faith' && p.data.pubDate <= now)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<LandingLayout title="Civilization & Faith | Libertaria" description="Ritual, stewardship, religion, and moral architecture through the Leave Us Alone lens.">
  <section class="lane-page">
    <header class="lane-header">
      <div class="lane-rule" style="background: var(--color-red);"></div>
      <h1 style="color: var(--color-red);">Civilization & Faith</h1>
      <p class="lane-subtitle">
        Ritual, stewardship, religion, and moral architecture<br />
        through the Leave Us Alone lens.
      </p>
    </header>
    {lanePosts.length === 0 ? (
      <div class="empty-state">
        <p>The old forms and the new exits.</p>
        <p class="hint">Check back soon.</p>
      </div>
    ) : (
      <div class="post-grid">
        {lanePosts.map((post) => (
          <article class="post-card" style="border-color: rgba(255,26,26,0.2);">
            <a href={`/blog/${post.slug}/`}>
              <div class="post-card-date">
                {post.data.pubDate.toLocaleDateString('en-us', { month: 'short', day: 'numeric', year: 'numeric' })}
                <span class="author-pill" style="background: rgba(255,26,26,0.15); color: var(--color-red);">{post.data.author}</span>
              </div>
              <h3>{post.data.title}</h3>
              <p class="post-card-desc">{post.data.description}</p>
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="post-card-tags">
                  {post.data.tags.slice(0, 3).map(tag => <span class="tag">#{tag}</span>)}
                </div>
              )}
            </a>
          </article>
        ))}
      </div>
    )}
  </section>
</LandingLayout>
<style>
  .lane-page { max-width: 1100px; margin: 0 auto; padding: 3rem 1rem; }
  .lane-header { text-align: center; margin-bottom: 3rem; }
  .lane-rule { width: 60px; height: 3px; margin: 0 auto 1.5rem; }
  .lane-header h1 { font-size: 3rem; margin-bottom: 0.5rem; }
  .lane-subtitle { font-size: 1.1rem; color: var(--color-gray); max-width: 520px; margin: 0 auto; line-height: 1.6; }
  .post-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem; }
  .post-card { background: var(--color-black-lighter); border: 1px solid rgba(255,26,26,0.15); border-radius: 12px; overflow: hidden; transition: border-color 0.3s ease, box-shadow 0.3s ease; }
  .post-card:hover { border-color: rgba(255,26,26,0.5); box-shadow: 0 0 20px rgba(255,26,26,0.06); }
  .post-card a { display: block; padding: 1.5rem; text-decoration: none; }
  .post-card-date { font-size: 0.8rem; color: var(--color-gray); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem; }
  .author-pill { padding: 0.1rem 0.5rem; border-radius: 4px; font-size: 0.75rem; }
  .post-card h3 { font-size: 1.15rem; color: var(--text); margin-bottom: 0.5rem; line-height: 1.3; }
  .post-card:hover h3 { color: var(--color-red); }
  .post-card-desc { font-size: 0.9rem; color: var(--color-gray); line-height: 1.5; margin-bottom: 0.75rem; }
  .post-card-tags { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .tag { font-size: 0.75rem; color: rgba(255,26,26,0.5); }
  .empty-state { text-align: center; padding: 4rem; color: var(--color-gray); }
  .hint { font-size: 0.85rem; opacity: 0.6; }
</style>
