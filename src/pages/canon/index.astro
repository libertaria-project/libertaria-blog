---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const now = new Date();

// Canon texts only, sorted by canonical_order (foundational sequence, not chronology)
const canonPosts = posts
	.filter(p => p.data.category === 'canon' && p.data.pubDate <= now)
	.sort((a, b) => (a.data.canonical_order ?? 999) - (b.data.canonical_order ?? 999));

// Format pillar slug into readable label
function formatPillar(pillar?: string): string {
	if (!pillar) return '';
	return pillar
		.split('-')
		.map(w => w.charAt(0).toUpperCase() + w.slice(1))
		.join(' ');
}
---

<Layout title="The Canon | Libertaria" description="Foundational texts of the Exitarian School. Principles, not commentary.">
	<section class="canon-page">
		<header class="canon-header">
			<div class="canon-rule"></div>
			<h1>The Canon</h1>
			<p class="canon-subtitle">
				Foundational texts of the Exitarian School.<br />
				These define the principles, not the commentary.
			</p>
			<div class="canon-count">{canonPosts.length} texts</div>
			<div class="canon-rule"></div>
		</header>

		<ol class="canon-list">
			{canonPosts.map((post) => (
				<li class="canon-entry">
					<div class="canon-number">
						{String(post.data.canonical_order ?? '').padStart(2, '0')}
					</div>
					<div class="canon-body">
						<h2 class="canon-title">
							<a href={`/blog/${post.slug}/`}>{post.data.title}</a>
						</h2>
						<p class="canon-description">{post.data.description}</p>
						<div class="canon-meta">
							{post.data.pillar && (
								<span class="canon-pillar">{formatPillar(post.data.pillar)}</span>
							)}
							<time datetime={post.data.pubDate.toISOString()}>
								{post.data.pubDate.toLocaleDateString('en-us', {
									year: 'numeric',
									month: 'long',
									day: 'numeric',
								})}
							</time>
						</div>
					</div>
				</li>
			))}
		</ol>

		<footer class="canon-footer">
			<div class="canon-rule"></div>
			<p>
				For Libertaria's implementation of these principles, see the
				<a href="/doctrine/">Doctrine</a>.<br />
				For commentary and analysis, see the
				<a href="/essays/">Essays</a>.
			</p>
		</footer>
	</section>
</Layout>

<style>
	/* --- Page Container --- */
	.canon-page {
		max-width: 800px;
		margin: 0 auto;
		padding: 4rem 1.5rem 6rem;
	}

	/* --- Header --- */
	.canon-header {
		text-align: center;
		margin-bottom: 4rem;
	}

	.canon-header h1 {
		font-family: 'Literata', Georgia, serif;
		font-size: 3.5rem;
		font-weight: 700;
		color: var(--accent);
		letter-spacing: 0.04em;
		margin: 1.5rem 0 1rem;
	}

	.canon-subtitle {
		font-size: 1.15rem;
		color: var(--color-gray);
		line-height: 1.7;
		max-width: 520px;
		margin: 0 auto 1.5rem;
	}

	.canon-count {
		font-size: 0.85rem;
		color: var(--color-gray);
		text-transform: uppercase;
		letter-spacing: 0.15em;
		margin-bottom: 1.5rem;
	}

	.canon-rule {
		width: 120px;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--accent), transparent);
		margin: 0 auto;
	}

	/* --- Canon List --- */
	.canon-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	/* --- Individual Entry --- */
	.canon-entry {
		display: flex;
		gap: 2rem;
		padding: 2.5rem 0;
		border-bottom: 1px solid rgba(255, 215, 0, 0.08);
		transition: border-color var(--duration-base) ease;
	}

	.canon-entry:first-child {
		border-top: 1px solid rgba(255, 215, 0, 0.08);
	}

	.canon-entry:hover {
		border-bottom-color: rgba(255, 215, 0, 0.25);
	}

	/* --- Number Column --- */
	.canon-number {
		font-family: 'Literata', Georgia, serif;
		font-size: 2.8rem;
		font-weight: 700;
		color: var(--accent);
		line-height: 1;
		min-width: 3.5rem;
		text-align: right;
		padding-top: 0.15rem;
		opacity: 0.85;
		user-select: none;
	}

	/* --- Body Column --- */
	.canon-body {
		flex: 1;
		min-width: 0;
	}

	.canon-title {
		font-family: 'Literata', Georgia, serif;
		font-size: 1.5rem;
		font-weight: 600;
		line-height: 1.35;
		margin: 0 0 0.75rem;
	}

	.canon-title a {
		color: var(--text);
		text-decoration: none;
		transition: color var(--duration-base) ease;
	}

	.canon-title a:hover {
		color: var(--accent);
	}

	.canon-title a:visited {
		color: var(--text);
	}

	.canon-description {
		font-size: 1rem;
		color: var(--color-gray);
		line-height: 1.65;
		margin: 0 0 1rem;
	}

	/* --- Meta Row --- */
	.canon-meta {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.canon-pillar {
		display: inline-block;
		background: rgba(255, 215, 0, 0.1);
		color: var(--accent);
		border: 1px solid rgba(255, 215, 0, 0.2);
		padding: 0.2rem 0.7rem;
		border-radius: 3px;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.canon-meta time {
		font-size: 0.8rem;
		color: var(--color-gray);
	}

	/* --- Footer --- */
	.canon-footer {
		margin-top: 4rem;
		text-align: center;
	}

	.canon-footer p {
		margin-top: 1.5rem;
		font-size: 1rem;
		color: var(--color-gray);
	}

	.canon-footer a {
		color: var(--color-red);
		text-decoration: underline;
		text-decoration-color: rgba(255, 26, 26, 0.4);
	}

	.canon-footer a:hover {
		color: var(--accent);
		text-decoration-color: var(--accent);
	}

	/* --- Responsive --- */
	@media (max-width: 640px) {
		.canon-page {
			padding: 2.5rem 1rem 4rem;
		}

		.canon-header h1 {
			font-size: 2.5rem;
		}

		.canon-subtitle {
			font-size: 1rem;
		}

		.canon-entry {
			gap: 1.25rem;
			padding: 2rem 0;
		}

		.canon-number {
			font-size: 2rem;
			min-width: 2.5rem;
		}

		.canon-title {
			font-size: 1.25rem;
		}

		.canon-description {
			font-size: 0.95rem;
		}
	}
</style>
