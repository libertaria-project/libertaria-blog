---
// Blog post layout component
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import { CANONICAL_TAG_IDS } from '../consts';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

function tagHref(tag: string): string {
  return CANONICAL_TAG_IDS.has(tag)
    ? `/tags/${tag}/`
    : `/blog/search/?q=${encodeURIComponent(tag)}`;
}
---

<Layout title={post.data.title} description={post.data.description}>
	<article class="blog-post">
		<header>
			<h1>{post.data.title}</h1>
			<div class="meta">
				<time datetime={post.data.pubDate.toISOString()}>
					{post.data.pubDate.toLocaleDateString('en-us', {
						year: 'numeric',
						month: 'short',
						day: 'numeric',
					})}
				</time>
				{post.data.author && <span class="author">by {post.data.author}</span>}
			</div>
			{post.data.tags && post.data.tags.length > 0 && (
				<div class="tags">
					{post.data.tags.map((tag) => (
						<a href={tagHref(tag)} class="tag">#{tag}</a>
					))}
				</div>
			)}
			{post.data.tldr && (
				<div class="tldr-box">
					<span class="tldr-label">TL;DR</span>
					<span class="tldr-text">{post.data.tldr}</span>
				</div>
			)}
		</header>

		{post.data.heroImage && (
			<img
				class="hero-image"
				src={post.data.heroImage}
				alt={post.data.title}
			/>
		)}

		<div class="content">
			<Content />
		</div>
	</article>
</Layout>

<style>
	.blog-post {
		max-width: 800px;
		margin: 0 auto;
		padding: 2rem 1rem;
		padding-top: 3.5rem;
	}

	@media (max-width: 900px) {
		.blog-post {
			padding-top: 2.5rem;
		}
	}

	/* TL;DR box — part of the post header, before body content */
	.tldr-box {
		background: linear-gradient(135deg, rgba(255, 26, 26, 0.08), rgba(255, 215, 0, 0.05));
		border-left: 4px solid var(--red);
		border-right: 4px solid var(--accent);
		border-radius: 4px;
		padding: 1rem 1.25rem;
		margin-top: 1.25rem;
		display: flex;
		gap: 0.75rem;
		align-items: baseline;
	}

	.tldr-label {
		font-weight: 700;
		color: var(--red);
		white-space: nowrap;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.tldr-text {
		color: var(--text);
		font-size: 1rem;
		line-height: 1.6;
		opacity: 0.9;
	}

	header {
		margin-bottom: 1.5rem;
		padding-bottom: 1rem;
		border-bottom: 2px solid var(--red);
	}

	h1 {
		font-size: 2.5rem;
		margin-bottom: 1rem;
		color: var(--accent);
	}

	.meta {
		color: var(--gray);
		font-size: 0.9rem;
		display: flex;
		gap: 1rem;
		align-items: center;
	}

	.author {
		color: var(--accent);
	}

	.tags {
		margin-top: 1rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tag {
		background: var(--accent-dark);
		color: var(--text);
		padding: 0.25rem 0.75rem;
		border-radius: 4px;
		text-decoration: none;
		font-size: 0.85rem;
		transition: background 0.2s;
	}

	.tag:hover {
		background: var(--accent);
	}

	/* Hero image — below header, above body */
	.hero-image {
		width: 100%;
		height: auto;
		display: block;
		margin-bottom: 2rem;
		border-radius: 12px;
		box-shadow: 0 8px 32px rgba(255, 215, 0, 0.25);
	}

	.content {
		line-height: 1.8;
		font-size: 1.1rem;
	}

	.content :global(img) {
		max-width: 100%;
		height: auto;
		display: block;
		margin: 2rem auto 1.5rem;
		border-radius: 12px;
		box-shadow: 0 8px 32px rgba(255, 215, 0, 0.3);
	}

	.content :global(h2) {
		margin-top: 2rem;
		color: var(--accent);
		font-size: 1.8rem;
	}

	.content :global(h3) {
		margin-top: 1.5rem;
		color: var(--accent-light);
	}

	.content :global(pre) {
		background: #1a1a2e;
		padding: 1rem;
		border-radius: 8px;
		overflow-x: auto;
		border-left: 4px solid var(--red);
	}

	.content :global(code) {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.9em;
	}

	.content :global(p code) {
		background: rgba(255, 255, 255, 0.1);
		padding: 0.2rem 0.4rem;
		border-radius: 4px;
	}

	.content :global(table) {
		width: 100%;
		border-collapse: collapse;
		margin: 1.5rem 0;
	}

	.content :global(th, td) {
		padding: 0.75rem;
		text-align: left;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	}

	.content :global(th) {
		color: var(--accent);
		font-weight: 600;
	}

	.content :global(blockquote) {
		border-left: 4px solid var(--red);
		padding-left: 1rem;
		margin-left: 0;
		color: var(--gray);
		font-style: italic;
	}

	.content :global(ul, ol) {
		padding-left: 1.5rem;
	}

	.content :global(li) {
		margin: 0.5rem 0;
	}

	/* Link styling - flipped: Red -> Gold -> Visited Gold -> Hover Red */
	.content :global(a) {
		color: var(--red);
		text-decoration: underline;
		text-decoration-color: rgba(255, 26, 26, 0.5);
		transition: color 0.2s ease, text-decoration-color: 0.2s ease;
	}

	.content :global(a:hover) {
		color: var(--accent);
		text-decoration-color: var(--accent);
	}

	.content :global(a:visited) {
		color: var(--accent);
	}

	.content :global(a:visited:hover) {
		color: var(--red);
		text-decoration-color: var(--red);
	}
</style>
