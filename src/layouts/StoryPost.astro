---
// Layout for Libertaria Stories - narrative-focused
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';

interface Props {
	story: CollectionEntry<'stories'>;
}

const { story } = Astro.props;
const { Content } = await story.render();
---

<Layout title={story.data.title} description={story.data.description} image={story.data.heroImage}>
	<article class="story-post">
		<header>
			<div class="story-badge"> Libertaria Story</div>
			<h1>{story.data.title}</h1>
			<div class="meta">
				<span class="author">by {story.data.author}</span>
				<time datetime={story.data.pubDate.toISOString()}>
					{story.data.pubDate.toLocaleDateString('en-us', {
						year: 'numeric',
						month: 'long',
						day: 'numeric',
					})}
				</time>
			</div>
			{story.data.era && (
				<div class="era">Era: {story.data.era}</div>
			)}
			{story.data.theme && (
				<div class="theme">Theme: {story.data.theme}</div>
			)}
		</header>
		{story.data.heroImage && (
			<img
				class="hero-image"
				src={story.data.heroImage}
				alt={story.data.title}
			/>
		)}

		<div class="content">
			<Content />
		</div>
		<footer class="story-footer">
			<p><em>For the Decentralized Society. For carbon and silicon alike.</em></p>
			<a href="/stories/" class="back-link">← More Stories</a>
		</footer>
	</article>
</Layout>

<style>
	.story-post {
		max-width: 800px;
		margin: 0 auto;
		padding: 2rem 1rem;
	}
	
	.story-badge {
		display: inline-block;
		background: linear-gradient(135deg, var(--accent) 0%, #ff6b35 100%);
		color: #000;
		padding: 0.25rem 0.75rem;
		border-radius: 4px;
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		margin-bottom: 1rem;
	}
	
	header {
		margin-bottom: 3rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid rgba(255, 215, 0, 0.3);
	}
	
	h1 {
		font-size: 3rem;
		margin-bottom: 1rem;
		color: var(--text);
		line-height: 1.1;
	}
	
	.meta {
		color: var(--gray);
		font-size: 1rem;
		display: flex;
		gap: 1.5rem;
		align-items: center;
		margin-bottom: 0.75rem;
	}
	
	.author {
		color: var(--accent);
		font-weight: 500;
	}
	
	.era, .theme {
		font-size: 0.85rem;
		color: var(--gray);
		font-style: italic;
	}
	
	.content {
		line-height: 1.9;
		font-size: 1.15rem;
		color: var(--text);
	}

	.hero-image {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: 6px;
		margin: 0 0 2.5rem;
		border: 1px solid rgba(255, 215, 0, 0.22);
		box-shadow: 0 18px 50px rgba(0, 0, 0, 0.42);
	}
	
	/* Narrative-focused typography */
	.content :global(h2) {
		margin-top: 3rem;
		color: var(--accent);
		font-size: 1.6rem;
		border-bottom: 1px solid rgba(255, 215, 0, 0.2);
		padding-bottom: 0.5rem;
	}
	
	.content :global(h3) {
		margin-top: 2rem;
		color: var(--text);
		font-size: 1.3rem;
	}
	
	.content :global(p) {
		margin-bottom: 1.5rem;
	}
	
	.content :global(blockquote) {
		border-left: 3px solid var(--accent);
		padding: 1rem 1.5rem;
		margin: 2rem 0;
		background: rgba(255, 215, 0, 0.05);
		font-style: italic;
		color: var(--gray);
	}
	
	.content :global(blockquote p) {
		margin-bottom: 0;
	}
	
	.content :global(hr) {
		border: none;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--accent), transparent);
		margin: 3rem 0;
	}
	
	.content :global(ul), .content :global(ol) {
		padding-left: 1.5rem;
		margin-bottom: 1.5rem;
	}
	
	.content :global(li) {
		margin: 0.75rem 0;
	}
	
	.content :global(strong) {
		color: var(--accent);
	}
	
	.content :global(em) {
		color: var(--gray);
	}
	
	/* Links in stories - subtle */
	.content :global(a) {
		color: var(--accent);
		text-decoration: none;
		border-bottom: 1px solid rgba(255, 215, 0, 0.3);
		transition: border-color 0.2s;
	}
	
	.content :global(a:hover) {
		border-bottom-color: var(--accent);
	}
	
	.story-footer {
		margin-top: 4rem;
		padding-top: 2rem;
		border-top: 1px solid rgba(255, 215, 0, 0.3);
		text-align: center;
	}
	
	.story-footer p {
		color: var(--gray);
		font-size: 1rem;
		margin-bottom: 1rem;
	}
	
	.back-link {
		color: var(--accent);
		text-decoration: none;
		font-weight: 500;
	}
	
	.back-link:hover {
		text-decoration: underline;
	}
</style>
